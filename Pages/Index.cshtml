@page
@model YeniKlasor.Pages.IndexModel
@{
    ViewData["Title"] = "Süt Sağım ve Tartı Takibi";
}

<!-- Page Header: Max 5-6 words title, max 2 sentences subtext -->
<div class="mb-10">
    <div class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Canlı Tartım İstasyonu</span>
        <span>•</span>
        <span>Ahır A</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight font-headline-lg">
        Süt Sağım ve Tartı Takibi
    </h1>
    <p class="text-base text-slate-500 mt-2 max-w-2xl font-body-md">
        Hayvan kimliği doğrulandı. Dört bacak yük dağılımı ve canlı ağırlık anlık olarak izleniyor.
    </p>
</div>

<!-- Primary Metrics Row (Minimalist Stripe/Apple style, generous whitespace, no nested neon boxes) -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-6 py-6 border-y border-slate-200/80 mb-10">
    <!-- Metric 1: Canlı Ağırlık -->
    <div>
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Canlı Ağırlık</span>
        <div class="mt-1 flex items-baseline gap-1.5">
            <span class="text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight tabular-nums font-data" id="metric-total-weight">
                @Model.DashboardData.Weight.CurrentWeightKg.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)
            </span>
            <span class="text-sm font-medium text-slate-500">kg</span>
        </div>
        <p class="text-xs text-emerald-600 mt-1">Son 5 dakikadır stabil</p>
    </div>

    <!-- Metric 2: Kimlik -->
    <div>
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Hayvan Kimliği</span>
        <div class="mt-1 text-2xl sm:text-3xl font-semibold text-slate-900 tracking-tight font-data" id="metric-animal-tag">
            @Model.DashboardData.Animal.RfidTag
        </div>
        <p class="text-xs text-slate-500 mt-1">@Model.DashboardData.Animal.Breed, @Model.DashboardData.Animal.Age yaşında</p>
    </div>

    <!-- Metric 3: Ön / Arka Oranı -->
    <div>
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Ön ve Arka Yükü</span>
        <div class="mt-1 text-2xl sm:text-3xl font-semibold text-slate-900 tracking-tight font-data">
            <span id="front-load-text">@Model.DashboardData.LegLoads.FrontTotalPercentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%</span>
            <span class="text-slate-300 font-normal">:</span>
            <span id="back-load-text">@Model.DashboardData.LegLoads.BackTotalPercentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%</span>
        </div>
        <p class="text-xs text-slate-500 mt-1">Denge aralığı normal</p>
    </div>

    <!-- Metric 4: Tırnak Durumu -->
    <div>
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Duruş Değerlendirmesi</span>
        <div class="mt-1 text-2xl sm:text-3xl font-semibold text-amber-600 tracking-tight">
            Sol Arka Hafif
        </div>
        <p class="text-xs text-slate-500 mt-1">Yük sağ tarafa aktarılıyor</p>
    </div>
</div>

<!-- Main Section: 3D Digital Twin & Leg Telemetry Breakdown -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-12">
    <!-- Left Column (7 cols): 3D Cow Visualizer Stage -->
    <div class="lg:col-span-7 flex flex-col">
        <div class="flex items-center justify-between pb-3">
            <div>
                <h2 class="text-lg font-semibold text-slate-900 font-headline-lg">3D Duruş ve Yük Analizi</h2>
                <p class="text-xs text-slate-500 mt-0.5">Modeli 360° döndürerek ayak temasını inceleyin.</p>
            </div>
            <div class="flex items-center gap-1.5">
                <button type="button" class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 flex items-center justify-center transition cursor-pointer" id="orbit-reset-btn" title="Açıyı Sıfırla">
                    <span class="material-symbols-outlined text-base">restart_alt</span>
                </button>
                <button type="button" class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 flex items-center justify-center transition cursor-pointer" id="expand-modal-btn" title="Tam Ekran İncele">
                    <span class="material-symbols-outlined text-base">open_in_full</span>
                </button>
            </div>
        </div>

        <!-- 3D Studio Canvas Area (Fills 75-80% of viewport with tight isometric framing) -->
        <div class="relative w-full aspect-[16/11] min-h-[380px] sm:min-h-[440px] rounded-2xl bg-[#F8FAFC] border border-slate-200/90 overflow-hidden select-none" id="three-stage-wrapper">
            <div class="w-full h-full cursor-grab active:cursor-grabbing absolute inset-0" id="three-canvas-container"></div>
            
            <!-- Minimal Helper Pills -->
            <div class="absolute top-4 left-4 pointer-events-none flex items-center gap-2 bg-white/90 backdrop-blur-xs px-3 py-1 rounded-full border border-slate-200 text-xs font-medium text-slate-700 shadow-xs">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>360° Etkileşimli Model</span>
            </div>

            <!-- Minimal Model Loading Shimmer / Indicator -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-500" id="model-loading-indicator">
                <div class="flex items-center gap-2 px-3.5 py-1.5 bg-white/90 backdrop-blur-xs rounded-full border border-slate-200 shadow-xs text-xs text-slate-500 font-medium">
                    <svg class="animate-spin h-3.5 w-3.5 text-slate-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Model yükleniyor...</span>
                </div>
            </div>

            <div class="absolute bottom-3 right-3 pointer-events-none text-[11px] text-slate-400 bg-white/85 backdrop-blur-xs px-2.5 py-1 rounded-md border border-slate-200/60 shadow-2xs">
                Çevirmek için sürükleyin
            </div>

            <!-- Dynamic 3D-Anchored Hoof Hotspot Pins (Coordinates calculated in real-time by Three.js) -->
            <div class="hotspot-anchor opacity-0" id="hotspot-FL" data-leg="FL">
                <div class="hotspot-pin hotspot-pin-normal" title="FL (Sol Ön)"></div>
            </div>
            <div class="hotspot-anchor opacity-0" id="hotspot-FR" data-leg="FR">
                <div class="hotspot-pin hotspot-pin-normal" title="FR (Sağ Ön)"></div>
            </div>
            <div class="hotspot-anchor opacity-0" id="hotspot-BL" data-leg="BL">
                <div class="hotspot-pin hotspot-pin-warn" title="BL (Sol Arka - Hafif Yük)"></div>
            </div>
            <div class="hotspot-anchor opacity-0" id="hotspot-BR" data-leg="BR">
                <div class="hotspot-pin hotspot-pin-normal" title="BR (Sağ Arka)"></div>
            </div>

            <!-- Compact Floating Glassmorphic Tooltip -->
            <div class="glass-tooltip absolute opacity-0 z-30 p-3 rounded-xl text-slate-800 w-52 transform -translate-x-1/2 -translate-y-full pointer-events-none" id="hoof-tooltip" style="margin-top: -12px;">
                <div class="flex items-center justify-between pb-1.5 mb-1.5 border-b border-slate-100">
                    <span class="text-xs font-semibold text-slate-900" id="tooltip-title">BL - Sol Arka</span>
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded text-amber-700 bg-amber-50 border border-amber-200/60" id="tooltip-status">Hafif Yük</span>
                </div>
                <div class="text-xs space-y-1">
                    <div class="flex justify-between items-baseline">
                        <span class="text-slate-400 text-[11px]">Canlı Ağırlık:</span>
                        <span class="font-semibold text-slate-900 font-data" id="tooltip-weight">108.2 kg</span>
                    </div>
                    <div class="flex justify-between items-baseline">
                        <span class="text-slate-400 text-[11px]">Toplam Yük Payı:</span>
                        <span class="font-medium text-slate-700 font-data" id="tooltip-share">%22.4</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column (5 cols): Hoof Distribution Details & Bullet Points -->
    <div class="lg:col-span-5 flex flex-col gap-6 pt-2">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 font-headline-lg">Dört Ayak Yük Dağılımı</h2>
            <p class="text-xs text-slate-500 mt-0.5">Sensörlerden okunan canlı ağırlık ve yüzdeler.</p>
        </div>

        <!-- 4 Leg Clean Rows -->
        <div class="divide-y divide-slate-100 border-y border-slate-100">
            <!-- FL -->
            <div class="py-3 flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-slate-900">Sol Ön Ayak (FL)</div>
                    <div class="text-xs text-slate-400">Yük hücresi #01</div>
                </div>
                <div class="text-right">
                    <div class="text-sm font-semibold text-slate-900 font-data" id="val-fl-kg">132.5 kg</div>
                    <div class="text-xs text-slate-500" id="pct-fl">%27.5 • Dengeli</div>
                </div>
            </div>

            <!-- FR -->
            <div class="py-3 flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-slate-900">Sağ Ön Ayak (FR)</div>
                    <div class="text-xs text-slate-400">Yük hücresi #02</div>
                </div>
                <div class="text-right">
                    <div class="text-sm font-semibold text-slate-900 font-data" id="val-fr-kg">131.0 kg</div>
                    <div class="text-xs text-slate-500" id="pct-fr">%27.1 • Dengeli</div>
                </div>
            </div>

            <!-- BL (Light Leg) -->
            <div class="py-3 flex items-center justify-between bg-amber-50/50 -mx-3 px-3 rounded-lg">
                <div>
                    <div class="text-sm font-medium text-amber-900">Sol Arka Ayak (BL)</div>
                    <div class="text-xs text-amber-700">Eksik yüklenme tespit edildi</div>
                </div>
                <div class="text-right">
                    <div class="text-sm font-semibold text-amber-900 font-data" id="val-bl-kg">108.2 kg</div>
                    <div class="text-xs font-medium text-amber-700" id="pct-bl">%22.4 • Düşük</div>
                </div>
            </div>

            <!-- BR -->
            <div class="py-3 flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-slate-900">Sağ Arka Ayak (BR)</div>
                    <div class="text-xs text-slate-400">Yük hücresi #04</div>
                </div>
                <div class="text-right">
                    <div class="text-sm font-semibold text-slate-900 font-data" id="val-br-kg">110.7 kg</div>
                    <div class="text-xs text-slate-500" id="pct-br">%23.0 • Dengeli</div>
                </div>
            </div>
        </div>

        <!-- Front vs Back Ratio Bar -->
        <div>
            <div class="flex justify-between text-xs font-medium text-slate-600 mb-1.5">
                <span>Ön Yük: <strong class="text-slate-900 font-data">54.6%</strong></span>
                <span>Arka Yük: <strong class="text-slate-900 font-data">45.4%</strong></span>
            </div>
            <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden flex gap-0.5">
                <div class="h-full bg-slate-800 rounded-l-full transition-all duration-300" id="front-load-bar" style="width: 54.6%"></div>
                <div class="h-full bg-slate-400 rounded-r-full transition-all duration-300" id="back-load-bar" style="width: 45.4%"></div>
            </div>
        </div>

        <!-- Human-Centered Micro Bullet Points (3-4 words each) -->
        <div class="pt-2">
            <h3 class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Önemli Bulgular</h3>
            <ul class="space-y-1.5 text-sm text-slate-600">
                <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    <span>Sol arka ayak hafif</span>
                </li>
                <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                    <span>Ağırlık öne aktarıldı</span>
                </li>
                <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                    <span>Tırnak kontrolü önerilir</span>
                </li>
                <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>Genel duruş stabil</span>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Secondary Section: Telemetry Stream & Clean Diagnostics -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 pt-8 border-t border-slate-200/80 mb-12">
    <!-- Telemetry Graph (7 cols) -->
    <div class="lg:col-span-7 flex flex-col">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-lg font-semibold text-slate-900 font-headline-lg">Telemetri Akışı</h2>
                <p class="text-xs text-slate-500 mt-0.5">10 Hz hızında yük hücresi verileri.</p>
            </div>
            <div class="flex items-center gap-1 bg-slate-100 p-0.5 rounded-lg text-xs">
                <button type="button" id="tab-filtered-data" class="px-2.5 py-1 font-medium rounded-md bg-white text-slate-900 shadow-xs cursor-pointer">Filtrelenmiş</button>
                <button type="button" id="tab-raw-data" class="px-2.5 py-1 font-medium rounded-md text-slate-500 hover:text-slate-900 cursor-pointer">Ham Veri</button>
            </div>
        </div>

        <div class="h-56 bg-slate-50/70 rounded-2xl border border-slate-200 p-4 relative flex items-end">
            <!-- Minimal Stripe-like Line Waveforms -->
            <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100">
                <path d="M0,35 Q20,32 40,36 T70,33 T100,35" fill="none" stroke="#0F172A" stroke-width="1.8"></path>
                <path d="M0,45 Q25,48 50,44 T80,47 T100,45" fill="none" stroke="#64748B" stroke-width="1.5"></path>
                <path d="M0,70 Q30,65 60,72 T100,68" fill="none" stroke="#D97706" stroke-width="1.5"></path>
                <path d="M0,60 Q20,62 50,58 T100,61" fill="none" stroke="#94A3B8" stroke-width="1.2" stroke-dasharray="2,2"></path>
            </svg>
            <div class="absolute bottom-3 left-4 flex gap-4 text-xs text-slate-500 font-medium">
                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-slate-900"></span> FL</span>
                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-slate-500"></span> FR</span>
                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-amber-500"></span> BL</span>
                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-slate-300"></span> BR</span>
            </div>
        </div>
    </div>

    <!-- Diagnostic List (5 cols) -->
    <div class="lg:col-span-5 flex flex-col">
        <div class="mb-4">
            <h2 class="text-lg font-semibold text-slate-900 font-headline-lg">Tanı Ölçümleri</h2>
            <p class="text-xs text-slate-500 mt-0.5">Sensör sapmaları ve tolerans eşikleri.</p>
        </div>

        <div class="divide-y divide-slate-100 border-y border-slate-100">
            <div class="py-3.5 flex items-center justify-between text-sm">
                <div>
                    <span class="font-medium text-slate-900">Yük Asimetrisi</span>
                    <p class="text-xs text-slate-400">Sol ve sağ taraf oranı</p>
                </div>
                <div class="text-right">
                    <span class="font-data font-semibold text-slate-900">0.97</span>
                    <span class="block text-xs text-emerald-600">Normal</span>
                </div>
            </div>

            <div class="py-3.5 flex items-center justify-between text-sm">
                <div>
                    <span class="font-medium text-slate-900">Ağırlık Farkı</span>
                    <p class="text-xs text-slate-400">Ön tırnaklar arası fark</p>
                </div>
                <div class="text-right">
                    <span class="font-data font-semibold text-slate-900">2.5 kg</span>
                    <span class="block text-xs text-emerald-600">Normal</span>
                </div>
            </div>

            <div class="py-3.5 flex items-center justify-between text-sm">
                <div>
                    <span class="font-medium text-slate-900">Yük Kayması</span>
                    <p class="text-xs text-slate-400">Arka sol tırnak sapması</p>
                </div>
                <div class="text-right">
                    <span class="font-data font-semibold text-amber-600">24.1 kg</span>
                    <span class="block text-xs text-amber-600">Kontrol Önerilir</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Footer Actions: Clean, Minimal Buttons -->
<div class="flex flex-wrap items-center gap-3 pt-6 border-t border-slate-200/80">
    <button type="button" id="btn-simulate" class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-medium transition cursor-pointer shadow-xs">
        Canlı Simülasyonu Başlat
    </button>
    
    <form method="post" asp-page-handler="ExportData" class="inline">
        <button type="submit" class="px-4 py-2.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 rounded-xl text-xs font-medium transition cursor-pointer">
            CSV Olarak İndir
        </button>
    </form>

    <button type="button" id="btn-system-logs" class="px-4 py-2.5 text-slate-500 hover:text-slate-900 rounded-xl text-xs font-medium transition ml-auto cursor-pointer">
        Sistem Günlükleri
    </button>
</div>

<!-- Fullscreen Focus Modal: Clean, High-Resolution Apple/Stripe Style -->
<div class="fixed inset-0 z-50 bg-slate-950/50 backdrop-blur-xs hidden items-center justify-center p-3 sm:p-6 lg:p-8" id="expand-modal">
    <div class="bg-white rounded-3xl w-full max-w-6xl h-[90vh] flex flex-col overflow-hidden shadow-2xl border border-slate-200">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div>
                <h3 class="font-semibold text-slate-900 text-base sm:text-lg font-headline-lg">Tırnak ve Bacak Basınç Haritası (Odak Modu)</h3>
                <p class="text-xs text-slate-500">TR-34-8902 • Siyah Alaca • 4 Kanallı HX711 Tartı İstasyonu</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="px-3.5 py-1.5 text-xs font-medium border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 rounded-lg cursor-pointer flex items-center gap-1.5 shadow-xs transition" id="modal-reset-orbit">
                    <span class="material-symbols-outlined text-sm">restart_alt</span> Açıyı &amp; Zoom'u Sıfırla
                </button>
                <button type="button" class="w-8 h-8 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-500 flex items-center justify-center cursor-pointer transition shadow-xs" id="close-modal-btn" title="Kapat">
                    <span class="material-symbols-outlined text-base">close</span>
                </button>
            </div>
        </div>

        <!-- Modal Body: Split View -->
        <div class="flex-1 grid grid-cols-1 lg:grid-cols-12 overflow-hidden">
            <!-- 3D Large Viewport -->
            <div class="lg:col-span-8 relative bg-[#F8FAFC] flex items-center justify-center border-b lg:border-b-0 lg:border-r border-slate-100">
                <div class="w-full h-full cursor-grab active:cursor-grabbing" id="modal-three-container"></div>
                
                <!-- Floating Controls Overlay -->
                <div class="absolute top-4 left-4 pointer-events-none flex items-center gap-2 bg-white/90 backdrop-blur-xs px-3 py-1 rounded-full border border-slate-200 text-xs font-medium text-slate-700 shadow-xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>360° Serbest Açı &amp; Zoom Aktif</span>
                </div>

                <div class="absolute bottom-3 right-3 pointer-events-none text-[11px] text-slate-400 bg-white/85 backdrop-blur-xs px-2.5 py-1 rounded-md border border-slate-200/60 shadow-2xs">
                    Çevirmek için sürükleyin • Yakınlaştırmak için kaydırın
                </div>
            </div>

            <!-- Prominent Telemetry Side-Cards for All 4 Legs -->
            <div class="lg:col-span-4 p-6 overflow-y-auto flex flex-col justify-between bg-white space-y-6">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Tırnak Telemetri Kartları</h4>
                        <span class="text-[11px] font-medium text-slate-500">10 Hz Anlık</span>
                    </div>
                    
                    <div class="space-y-3">
                        <!-- FL -->
                        <div class="p-3.5 bg-slate-50/80 rounded-2xl border border-slate-100 hover:border-slate-200 transition">
                            <div class="flex justify-between items-start">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                    <div>
                                        <div class="text-xs font-semibold text-slate-900">Sol Ön Ayak (FL)</div>
                                        <div class="text-[10px] text-slate-400">HX711 Sensör #01</div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-bold text-slate-900 font-data" id="modal-val-fl">132.5 kg</div>
                                    <div class="text-[11px] font-medium text-emerald-600" id="modal-pct-fl">%27.5 (Normal)</div>
                                </div>
                            </div>
                        </div>

                        <!-- FR -->
                        <div class="p-3.5 bg-slate-50/80 rounded-2xl border border-slate-100 hover:border-slate-200 transition">
                            <div class="flex justify-between items-start">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                    <div>
                                        <div class="text-xs font-semibold text-slate-900">Sağ Ön Ayak (FR)</div>
                                        <div class="text-[10px] text-slate-400">HX711 Sensör #02</div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-bold text-slate-900 font-data" id="modal-val-fr">131.0 kg</div>
                                    <div class="text-[11px] font-medium text-emerald-600" id="modal-pct-fr">%27.1 (Normal)</div>
