<!-- TopAppBar: Minimal, Apple/Stripe Inspired -->
<header class="bg-white/90 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Brand & Location -->
        <div class="flex items-center gap-4">
            <a href="/" class="flex items-center gap-3 group focus:outline-hidden">
                <div class="h-9 w-9 sm:h-10 sm:w-10 rounded-xl bg-white border border-slate-200/80 p-0.5 flex items-center justify-center shadow-xs overflow-hidden flex-shrink-0 transition group-hover:border-slate-300">
                    <img src="~/images/ingek-logo.jpeg" alt="İNGEK Logo" class="h-full w-full object-contain mix-blend-multiply" />
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-slate-900 tracking-tight text-base sm:text-lg font-headline-lg leading-tight">İNGEK</span>
                    <span class="text-[10px] font-medium text-slate-400 tracking-wide uppercase leading-none hidden sm:block">Akıllı Hayvancılık</span>
                </div>
            </a>
            <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>
            <div class="hidden sm:flex items-center gap-2 text-xs text-slate-500 font-medium">
                <span>Ahır A</span>
                <span>/</span>
                <span class="text-slate-700">İstasyon #01</span>
            </div>
        </div>

        <!-- Telemetry Connection Status & Actions -->
        <div class="flex items-center gap-3 sm:gap-6">
            <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-medium">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span id="esp32-status-text">ESP32 Aktif</span>
                <span class="text-slate-300">•</span>
                <span class="text-slate-500 font-mono text-[11px]" id="esp32-latency">42ms</span>
            </div>

            <span class="font-mono text-xs text-slate-400 hidden md:block" id="utc-clock">
                14:22:05 UTC
            </span>

            <form method="post" asp-page-handler="ExportData" class="inline">
                <button type="submit" class="px-3.5 py-1.5 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg transition-colors cursor-pointer shadow-xs">
                    Veri İndir
                </button>
            </form>
        </div>
    </div>
</header>
