<!-- TopAppBar Component -->
<header class="bg-background/80 backdrop-blur-md border-b border-outline-variant docked full-width top-0 z-50 sticky">
    <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto">
        <!-- Brand & Context -->
        <div class="flex items-center gap-4 lg:gap-6">
            <div class="w-11 h-11 rounded-lg bg-surface-card border border-surface-border flex items-center justify-center p-1.5 shadow-sm">
                <span class="material-symbols-outlined text-secondary text-2xl" style="font-variation-settings: 'FILL' 1;">hub</span>
            </div>
            <div class="hidden sm:block">
                <div class="flex items-center flex-wrap gap-2">
                    <span class="px-3 py-0.5 bg-secondary-container/20 text-secondary border border-secondary/30 rounded-full font-data-sm text-data-sm">
                        @(Model?.DashboardData?.DeviceStatus?.EventTag ?? "TEKNOFEST 2026 İnovasyon")
                    </span>
                    <span class="text-text-muted font-body-sm hidden lg:inline">
                        @(Model?.DashboardData?.DeviceStatus?.FarmName ?? "Marmara Süt Çiftliği - Ahır A")
                    </span>
                    <span class="text-on-surface font-body-sm font-medium">
                        @(Model?.DashboardData?.DeviceStatus?.StationName ?? "/ Süt Sağım Tartı İstasyonu #01")
                    </span>
                </div>
            </div>
        </div>

        <!-- Telemetry Status & Controls -->
        <div class="flex items-center gap-4 lg:gap-6">
            <div class="hidden xl:flex items-center gap-2 bg-surface-card border border-primary/30 px-4 py-2 rounded-lg shadow-sm">
                <div class="w-2 h-2 rounded-full bg-primary pulse-dot" id="esp32-status-dot"></div>
                <span class="font-data-sm text-data-sm text-primary font-semibold" id="esp32-status-text">ESP32 Bağlı</span>
                <span class="text-outline mx-2">|</span>
                <span class="font-data-sm text-data-sm text-text-muted" id="esp32-hz-text">@(Model?.DashboardData?.DeviceStatus?.FrequencyText ?? "10 Hz Veri Akışı")</span>
                <span class="text-outline mx-2">|</span>
                <span class="font-data-sm text-data-sm text-text-muted">Gecikme: <span class="text-secondary font-mono" id="esp32-latency">@(Model?.DashboardData?.DeviceStatus?.LatencyMs ?? 42)ms</span></span>
            </div>

            <div class="flex items-center gap-4">
                <span class="font-data-sm text-data-sm text-text-muted font-mono hidden md:block bg-surface-card px-3 py-1.5 rounded border border-surface-border" id="utc-clock">
                    14:22:05 UTC
                </span>
                
                <div class="flex gap-1 text-on-surface-variant">
                    <button type="button" title="Sensörleri Tara" class="hover:text-primary hover:bg-surface-container-high transition-colors p-2 rounded-lg cursor-pointer">
                        <span class="material-symbols-outlined">sensors</span>
                    </button>
                    <button type="button" title="Zamanlanmış Görevler" class="hover:text-primary hover:bg-surface-container-high transition-colors p-2 rounded-lg cursor-pointer">
                        <span class="material-symbols-outlined">schedule</span>
                    </button>
                </div>

                <div class="w-10 h-10 rounded-full bg-surface-variant overflow-hidden border border-outline-variant flex items-center justify-center text-primary font-bold shadow-inner">
                    <span class="material-symbols-outlined text-xl">admin_panel_settings</span>
                </div>
            </div>
        </div>
    </div>
</header>
