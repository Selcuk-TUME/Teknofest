<!DOCTYPE html>
<html class="dark" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "İNGEK-İOT Analiz Paneli")</title>

    <!-- Tailwind CSS with Plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600;700&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind Theme Configuration -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary-fixed-dim": "#4edea3",
                        "on-tertiary-container": "#711419",
                        "on-primary-fixed-variant": "#005236",
                        "background": "#0f131c",
                        "outline": "#86948a",
                        "surface-tint": "#4edea3",
                        "surface-container-lowest": "#0a0e16",
                        "inverse-surface": "#dfe2ee",
                        "text-primary": "#F8FAFC",
                        "warning-amber": "#F59E0B",
                        "surface-bright": "#353942",
                        "inverse-on-surface": "#2c3039",
                        "tertiary-fixed": "#ffdad7",
                        "surface-container-low": "#181c24",
                        "inverse-primary": "#006c49",
                        "primary-container": "#10b981",
                        "on-surface-variant": "#bbcabf",
                        "surface-dim": "#0f131c",
                        "outline-variant": "#3c4a42",
                        "on-primary": "#003824",
                        "on-secondary-fixed-variant": "#004e5c",
                        "surface-container-highest": "#31353e",
                        "surface-container": "#1c2028",
                        "on-tertiary-fixed": "#410005",
                        "on-surface": "#dfe2ee",
                        "tertiary-fixed-dim": "#ffb3af",
                        "on-secondary-container": "#00424e",
                        "surface": "#0f131c",
                        "text-muted": "#94A3B8",
                        "tertiary": "#ffb3af",
                        "on-primary-fixed": "#002113",
                        "primary": "#4edea3",
                        "on-error-container": "#ffdad6",
                        "on-primary-container": "#00422b",
                        "on-secondary-fixed": "#001f26",
                        "primary-fixed": "#6ffbbe",
                        "alarm-rose": "#F43F5E",
                        "on-background": "#dfe2ee",
                        "secondary": "#4cd7f6",
                        "tertiary-container": "#fc7c78",
                        "on-tertiary": "#650911",
                        "on-error": "#690005",
                        "surface-card": "#131B2A",
                        "secondary-fixed-dim": "#4cd7f6",
                        "secondary-container": "#03b5d3",
                        "on-secondary": "#003640",
                        "surface-variant": "#31353e",
                        "secondary-fixed": "#acedff",
                        "error": "#ffb4ab",
                        "error-container": "#93000a",
                        "surface-container-high": "#262a33",
                        "surface-border": "#1E293B",
                        "on-tertiary-fixed-variant": "#842225"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    spacing: {
                        "unit": "4px",
                        "stack-md": "20px",
                        "container-max": "1440px",
                        "stack-sm": "12px",
                        "margin-desktop": "32px",
                        "margin-mobile": "16px",
                        "gutter": "24px"
                    },
                    fontFamily: {
                        "headline-lg": ["Outfit", "sans-serif"],
                        "headline-lg-mobile": ["Outfit", "sans-serif"],
                        "body-sm": ["Inter", "sans-serif"],
                        "body-md": ["Inter", "sans-serif"],
                        "display-lg": ["Outfit", "sans-serif"],
                        "data-sm": ["JetBrains Mono", "monospace"],
                        "data-lg": ["JetBrains Mono", "monospace"]
                    },
                    fontSize: {
                        "headline-lg": ["32px", { lineHeight: "40px", fontWeight: "600" }],
                        "headline-lg-mobile": ["24px", { lineHeight: "32px", fontWeight: "600" }],
                        "body-sm": ["14px", { lineHeight: "20px", fontWeight: "400" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "display-lg": ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "data-sm": ["12px", { lineHeight: "16px", letterSpacing: "0.05em", fontWeight: "500" }],
                        "data-lg": ["24px", { lineHeight: "32px", letterSpacing: "0.02em", fontWeight: "600" }]
                    }
                }
            }
        };
    </script>

    <!-- Custom Project Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-background text-text-primary min-h-screen flex font-body-md overflow-x-hidden selection:bg-primary-container selection:text-on-primary-container">
    <!-- Modular Side Navigation -->
    <partial name="_SideNav" />

    <!-- Main Application Canvas -->
    <main class="flex-1 md:ml-64 flex flex-col min-h-screen">
        <!-- Top App Bar -->
        <partial name="_TopAppBar" />

        <!-- Dynamic Content Body -->
        @RenderBody()
    </main>

    <!-- System Logs Modal (Accessible via JS) -->
    <div id="system-logs-modal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 hidden">
        <div class="glass-card rounded-2xl w-full max-w-2xl p-6 border border-surface-border shadow-2xl">
            <div class="flex justify-between items-center pb-4 border-b border-surface-border mb-4">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary">terminal</span>
                    <h3 class="font-headline-lg-mobile text-lg text-text-primary">ESP32 & Sensör Sistem Günlükleri</h3>
                </div>
                <button type="button" onclick="closeSystemLogsModal()" class="text-text-muted hover:text-text-primary cursor-pointer p-1 rounded-lg hover:bg-surface-container-high">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="bg-surface-container-lowest p-4 rounded-xl font-mono text-xs text-text-muted space-y-1.5 max-h-72 overflow-y-auto border border-surface-border">
                <p class="text-secondary">[14:22:01.102] [ESP32-CORE] Wi-Fi bağlı, IP: 192.168.1.144, Sinyal: -54 dBm</p>
                <p class="text-primary">[14:22:01.215] [HX711-BUS] 4 Kanallı Yük Hücresi ADC kalibre edildi (Ofset: 84201)</p>
                <p class="text-text-muted">[14:22:02.000] [TELEMETRY] 10 Hz yayın başlatıldı (JSON Frame #4920)</p>
                <p class="text-primary">[14:22:03.110] [RFID] Kart okundu: TR-34-8902 (Holstein-Friesian)</p>
                <p class="text-warning-amber">[14:22:04.420] [BIOMECHANICS] Sol arka bacakta (BL) yük kaybı tespit edildi: 108.2kg</p>
                <p class="text-alarm-rose">[14:22:05.012] [ALARM] Yük Kayması eşik değeri aşıldı: Δ 24.1kg!</p>
            </div>
            <div class="mt-4 flex justify-end gap-3">
                <button type="button" onclick="closeSystemLogsModal()" class="px-4 py-2 bg-surface-container-high hover:bg-surface-variant text-text-primary rounded-lg text-sm">
                    Kapat
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
