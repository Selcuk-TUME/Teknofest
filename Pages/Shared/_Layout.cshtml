<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "İNGEK - Süt Sağım ve Tartı Takibi")</title>

    <!-- Tailwind CSS with Plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts: Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />

    <!-- Google Material Symbols Outlined (used selectively for real actions only) -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Three.js 3D Engine & FBX Loaders -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fflate@0.7.4/umd/index.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/FBXLoader.js"></script>

    <!-- Tailwind Theme Configuration: Natural, Human, Apple/Stripe-Inspired Colors -->
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: "#F8FAFC",
                        surface: "#FFFFFF",
                        "slate-heading": "#0F172A",
                        "slate-body": "#334155",
                        "slate-muted": "#64748B",
                        accent: "#0F172A",
                        positive: "#059669",
                        warning: "#D97706",
                        alert: "#E11D48"
                    },
                    fontFamily: {
                        "headline-lg": ["Outfit", "sans-serif"],
                        "body-md": ["Inter", "sans-serif"],
                        "data": ["JetBrains Mono", "monospace"]
                    }
                }
            }
        };
    </script>

    <!-- Custom Minimalist Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-background text-slate-800 min-h-screen flex flex-col font-body-md antialiased selection:bg-slate-900 selection:text-white">
    <!-- Top App Bar -->
    <partial name="_TopAppBar" />

    <!-- Main Content Canvas (Breathable, Centered, Generous Whitespace) -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
        @RenderBody()
    </main>

    <!-- Clean Footer -->
    <footer class="border-t border-slate-200/80 bg-white py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400">
            <p>İNGEK Çiftlik Otomasyonu • 2026</p>
            <p>4 Kanallı HX711 Tartı İstasyonu</p>
        </div>
    </footer>

    <!-- System Logs Modal (Accessible via JS) -->
    <div id="system-logs-modal" class="fixed inset-0 z-50 bg-slate-950/40 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl w-full max-w-2xl p-6 border border-slate-200 shadow-xl">
            <div class="flex justify-between items-center pb-4 border-b border-slate-100 mb-4">
                <h3 class="font-semibold text-slate-900 text-sm">Sistem Günlükleri</h3>
                <button type="button" onclick="closeSystemLogsModal()" class="text-slate-400 hover:text-slate-700 cursor-pointer p-1 rounded-lg">
                    <span class="material-symbols-outlined text-lg">close</span>
                </button>
            </div>
            <div class="bg-slate-50 p-4 rounded-xl font-data text-xs text-slate-600 space-y-1.5 max-h-72 overflow-y-auto border border-slate-100">
                <p class="text-slate-500">[14:22:01] Wi-Fi bağlı, IP: 192.168.1.144</p>
                <p class="text-slate-500">[14:22:01] 4 kanallı yük hücresi kalibre edildi</p>
                <p class="text-slate-500">[14:22:02] 10 Hz telemetri akışı başladı</p>
                <p class="text-slate-900 font-medium">[14:22:03] RFID okundu: TR-34-8902</p>
                <p class="text-amber-600 font-medium">[14:22:04] Sol arka bacakta yük kaybı: 108.2 kg</p>
            </div>
            <div class="mt-4 flex justify-end">
                <button type="button" onclick="closeSystemLogsModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium cursor-pointer">
                    Kapat
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
